  CARE -- "yes" --> CARES["Start and stop<br/>detection automatically<br/>Board problem alert<br/>Training session routine"]
  CARE -- "no" --> REPORT{"A summary of<br/>your training?"}
  REPORT -- "yes" --> REPORTS["Training report, each day<br/>Weekly report"]
  REPORT -- "no" --> VOICE{"Talk to Assist?"}
  VOICE -- "yes" --> VOICES["Start a game by voice<br/>Enter darts by voice<br/>Ask Assist about your darts"]
