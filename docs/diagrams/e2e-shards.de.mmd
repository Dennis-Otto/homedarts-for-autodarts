config:
  flowchart:
    wrappingWidth: 400
---
flowchart TB
  accTitle: Die End-to-End-Tests nebeneinander
  accDescr: Findet der Job changes etwas zu testen, starten neun Test-Jobs zugleich. Drei führen das Szenario aus, für Board Manager 1, Board Manager 2 und Home Assistant 2026.8.0. Sechs führen den Browsertest aus, drei für das aktuelle und drei für das älteste unterstützte Home Assistant, sodass alle vier Teile einer Version zugleich laufen, jeder auf einer eigenen Demo-Instanz. Der erste Runner einer Version führt zwei Worker aus, die Karten, Spiele und Formulare neben den gleichbleibenden Höhen; der zweite das Tablet, jede Bildschirmgröße, Firefox und die Dartscheibe ohne Autodarts; der dritte die Touchscreens, Safari und die Barrierefreiheit allein, damit sich WebKit von Safari die CPU mit keinem anderen Browser teilt. Die Pflichtprüfung e2e wartet auf alle.

  CHANGES{{"changes: ändert der Pull Request,<br/>was die Tests nutzen?"}}
  CHANGES --> SCENARIO
  CHANGES --> CURRENT
  CHANGES --> OLDEST

  subgraph SCENARIO["scenario (run.sh)"]
    direction LR
    S1["Board Manager 1"] ~~~ S2["Board Manager 2"] ~~~ S3["Home Assistant<br/>2026.8.0"]
  end

  subgraph CURRENT["browser, aktuell"]
    direction LR
    C1["Runner 1, zwei Worker<br/>Teil 1/4: Karten, Spiele, Formulare<br/>Teil 2/4: gleichbleibende Höhen"]
    C2["Runner 2<br/>Teil 3/4: Tablet,<br/>jede Bildschirmgröße,<br/>Firefox, Dartscheibe<br/>ohne Autodarts"]
    C3["Runner 3<br/>Teil 4/4: Touchscreens,<br/>Safari, Barrierefreiheit"]
  end

  subgraph OLDEST["browser, 2026.8.0"]
    direction LR
    O1["Runner 1<br/>Teile 1/4 und 2/4"]
    O2["Runner 2<br/>Teil 3/4"]
    O3["Runner 3<br/>Teil 4/4"]
  end

  SCENARIO --> GATE["Pflichtprüfung e2e:<br/>besteht, wenn jeder Job bestand"]
  CURRENT --> GATE
  OLDEST --> GATE

  classDef bot fill:#526cfe2e,stroke:#526cfe,stroke-width:2px
  classDef done fill:#16a34a2e,stroke:#16a34a,stroke-width:2px
  class CHANGES bot
  class S1,S2,S3,C1,C2,C3,O1,O2,O3 bot
  class GATE done
