{
  "name": "hacs-homedarts-development",
  "private": true,
  "description": "Development tooling for the Autodarts dashboard cards and the translation bot. Nothing here is published or shipped.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 --experimental-test-coverage --test-coverage-include=custom_components/homedarts/frontend/homedarts-card.js --test-coverage-include=custom_components/homedarts/frontend/homedarts-strategy.js --test-coverage-include=custom_components/homedarts/frontend/text/*.js --test-coverage-include=scripts/translations.mjs --test-coverage-include=docs/demo/demo.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"tests/frontend/*.test.mjs\" \"tests/frontend/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4"
  }
}
