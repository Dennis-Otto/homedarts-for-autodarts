// Renovate for this repository: the rules of the blueprint in
// .github/renovate-blueprint.json5, then those of the project alone below, which
// override them, such as a package that must wait or two that move together:
// https://docs.renovatebot.com/configuration-options/
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/homedarts-for-autodarts//.github/renovate-blueprint.json5"],
  packageRules: [
    {
      // The end-to-end tests run the oldest Home Assistant that the integration
      // supports (hacs.json), which tests/test_consistency.py compares; only the
      // digest of its image moves.
      matchFileNames: [".github/workflows/e2e.yml"],
      matchDepNames: ["ghcr.io/home-assistant/home-assistant"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
    {
      // Assist's packages in the tests are those of the conversation manifest of
      // the Home Assistant that pytest-homeassistant-custom-component pins, which
      // tests/test_voice_blueprints.py compares: they move with that Home
      // Assistant, by scripts/pin_assist.py, never on their own. The fix bot runs
      // it when the CI of the pull request for a new test base fails (the autofix of
      // the step of the tests in .github/checks.project.toml), so that pull request
      // pins them by itself.
      matchDepNames: ["hassil", "home-assistant-intents", "gazetteer-matcher"],
      enabled: false,
    },
    {
      matchFileNames: ["tests/e2e/requirements-browser.txt"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the browser tests",
    },
    {
      // Playwright must match the browsers of its image in tests/e2e/browser.sh,
      // so the two move in one pull request.
      matchFileNames: ["tests/e2e/**"],
      matchDepNames: ["playwright", "mcr.microsoft.com/playwright/python"],
      groupName: "Playwright and its browsers",
    },
    {
      // The tools of the tests of the cards; nothing of it is shipped.
      matchManagers: ["npm"],
      semanticCommitType: "chore",
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the tests of the cards",
    },
  ],
}
